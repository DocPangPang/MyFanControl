<Window x:Class="MyFanControl.Modern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MyFanControl.Modern.Controls"
        Title="MyFanControl Modern"
        Width="1180" Height="820" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="22,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <Border Width="48" Height="48" HorizontalAlignment="Left"
                            CornerRadius="14" Background="{StaticResource PrimaryBrush}">
                        <TextBlock Text="F" FontSize="25" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="MyFanControl" FontSize="21" FontWeight="SemiBold" Margin="0,14,0,2"/>
                    <TextBlock Text="Modern Preview" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Background="#263650" CornerRadius="9" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" Foreground="{StaticResource SecondaryBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="监控与控制" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="拖动曲线上的控制点即可调整温度和风扇占空比。"
                               Margin="12,16,8,0" TextWrapping="Wrap"
                               FontSize="12" LineHeight="19"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <TextBlock Text="硬件接口" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding HardwareName}" TextWrapping="Wrap"
                               FontSize="12" Margin="0,5,0,14"/>
                    <Button Content="恢复原厂自动控制"
                            Command="{Binding RestoreAutomaticCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30,26,30,34">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="散热控制中心" FontSize="27" FontWeight="SemiBold"/>
                        <TextBlock Text="实时状态、可视化风扇曲线与安全控制"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="18" Padding="13,7"
                            Background="#3B2D1C" Visibility="{Binding IsSimulation, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="演示模式" Foreground="#FFC36A" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <UniformGrid Columns="4" Margin="0,24,0,18">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="CPU 温度" Foreground="{StaticResource MutedTextBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,4">
                                <TextBlock Text="{Binding CpuTemperature}" FontSize="30" FontWeight="SemiBold"/>
                                <TextBlock Text=" °C" FontSize="16" VerticalAlignment="Bottom" Margin="2,0,0,5"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CpuDuty, StringFormat='当前占空比 {0}%'}"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="CPU 风扇" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock Text="{Binding CpuRpm}" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,4"/>
                            <TextBlock Text="估算 RPM" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="GPU 温度" Foreground="{StaticResource MutedTextBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,4">
                                <TextBlock Text="{Binding GpuTemperature}" FontSize="30" FontWeight="SemiBold"/>
                                <TextBlock Text=" °C" FontSize="16" VerticalAlignment="Bottom" Margin="2,0,0,5"/>
                            </StackPanel>
                            <TextBlock Text="{Binding GpuDuty, StringFormat='当前占空比 {0}%'}"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="GPU 风扇" Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock Text="{Binding GpuRpm}" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,4"/>
                            <TextBlock Text="估算 RPM" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Width="210">
                            <TextBlock Text="控制方案" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                      Margin="0,7,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProfileDescription}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="接管风扇" FontWeight="SemiBold"/>
                                <TextBlock Text="退出时自动恢复" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                            </StackPanel>
                            <ToggleButton IsChecked="{Binding IsTakeover}" Style="{StaticResource ToggleSwitchStyle}"/>
                            <Button Content="{Binding ForceCoolingButtonText}" Command="{Binding ForceCoolingCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="16,0,0,0"/>
                            <Button Content="保存方案" Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="CPU 风扇曲线" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="拖动控制点" HorizontalAlignment="Right"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                            </Grid>
                            <controls:FanCurveEditor Height="265"
                                Points="{Binding SelectedProfile.CpuPoints}"
                                CurveBrush="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="GPU 风扇曲线" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="拖动控制点" HorizontalAlignment="Right"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                            </Grid>
                            <controls:FanCurveEditor Height="265"
                                Points="{Binding SelectedProfile.GpuPoints}"
                                CurveBrush="{StaticResource SecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="回差温度" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding HysteresisDegrees, StringFormat='{}{0} °C'}"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,4"/>
                            <Slider Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding HysteresisDegrees}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,24,0">
                            <TextBlock Text="强制冷却目标" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ForceCoolingTarget, StringFormat='{}{0} °C'}"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,4"/>
                            <Slider Minimum="40" Maximum="90" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding ForceCoolingTarget}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,24,0">
                            <TextBlock Text="更新间隔" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding UpdateIntervalSeconds, StringFormat='{}{0} 秒'}"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,4"/>
                            <Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding UpdateIntervalSeconds}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton IsChecked="{Binding LinearInterpolation}"
                                          Style="{StaticResource ToggleSwitchStyle}"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="线性控制" FontWeight="SemiBold"/>
                                <TextBlock Text="平滑插值曲线" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton IsChecked="{Binding StartWithWindows}"
                                          Style="{StaticResource ToggleSwitchStyle}"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="开机启动" FontWeight="SemiBold"/>
                                <TextBlock Text="当前用户" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="恢复当前预设" Command="{Binding ResetPresetCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
